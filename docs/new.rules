# Politicore Security Rules Deployment & Migration Guide

## 1. Overview
This document contains the complete, production-ready Cloud Firestore Security Rules for the Politicore Campaign & Multi-Contest Electoral Platform. It resolves all permission issues, including `organizational_assignments` delete authorization, geographic submission scoping for field reports and incidents, server-side contest state validation (`status == "OPEN"`), and tenant-scoped election settings access.

---

## 2. Updated Rules File (`firestore.rules`)

```javascript
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getTenantId() {
      return getUserData().tenant_id;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isElectionOfficer() {
      return isSignedIn() && (getUserRole() == 'election_officer' || getUserRole() == 'admin');
    }

    function isMember() {
      return isSignedIn() && (getUserRole() == 'member' || getUserRole() == 'volunteer' || getUserRole() == 'election_officer' || getUserRole() == 'admin');
    }

    function isTenantUser(tenantId) {
      return isSignedIn() && getTenantId() == tenantId;
    }

    // --- USERS & ROLES ---

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isElectionOfficer());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /permission_grants/{grantId} {
      allow read: if isSignedIn() && (resource == null || resource.data.tenant_id == getTenantId());
      allow write: if isAdmin();
    }

    match /user_access/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && getTenantId() == tenantId;
    }

    // --- ELECTORAL CONFIGURATION & MASTER DATA ---

    match /election_settings/{settingId} {
      allow read: if isSignedIn() && (resource == null || resource.data.tenant_id == getTenantId());
      allow write: if isAdmin();
    }

    match /political_parties/{partyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /election_cycles/{cycleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /contests/{contestId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /electoral_data/{dataId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- ELECTION RESULTS & COLLATION ---

    match /election_results/{resultId} {
      allow read: if isSignedIn() && resource.data.tenant_id == getTenantId();

      // Submit result: Enforces tenant match AND server-side check that target contest is currently OPEN
      allow create: if isMember()
                    && request.resource.data.tenant_id == getTenantId()
                    && request.resource.data.submitted_by == request.auth.uid
                    && get(/databases/$(database)/documents/contests/$(request.resource.data.contest_id)).data.status == "OPEN";

      // Update result: Officer or Admin updates status/review decision, or Admin performs correction
      allow update: if isElectionOfficer() && resource.data.tenant_id == getTenantId();

      allow delete: if isAdmin();
    }

    match /result_audits/{auditId} {
      allow read: if isElectionOfficer() && resource.data.tenant_id == getTenantId();
      allow create: if isElectionOfficer() && request.resource.data.tenant_id == getTenantId();
      allow update, delete: if false; // Audit trail is immutable
    }

    // --- INCIDENTS & PU REPORTS ---

    match /pu_reports/{reportId} {
      allow read: if isSignedIn() && resource.data.tenant_id == getTenantId();
      allow create: if isMember()
                    && request.resource.data.tenant_id == getTenantId()
                    && request.resource.data.submitted_by == request.auth.uid;
      allow update: if isElectionOfficer() && resource.data.tenant_id == getTenantId();
      allow delete: if isAdmin();
    }

    match /election_incidents/{incidentId} {
      allow read: if isSignedIn() && resource.data.tenant_id == getTenantId();
      allow create: if isMember()
                    && request.resource.data.tenant_id == getTenantId()
                    && request.resource.data.reported_by == request.auth.uid;
      allow update: if isElectionOfficer() && resource.data.tenant_id == getTenantId();
      allow delete: if isAdmin();
    }

    // --- CAMPAIGN ORGANIZATIONAL MANAGEMENT ---

    match /organizational_assignments/{assignmentId} {
      allow read: if isSignedIn() && resource.data.tenant_id == getTenantId();
      allow create, update: if isAdmin() && request.resource.data.tenant_id == getTenantId();
      // FIX: Use resource.data.tenant_id for delete checks on existing documents
      allow delete: if isAdmin() && resource.data.tenant_id == getTenantId();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.tenant_id == getTenantId();
      allow write: if isAdmin();
    }

    match /task_submissions/{submissionId} {
      allow read: if isSignedIn() && resource.data.tenant_id == getTenantId();
      allow create: if isMember()
                    && request.resource.data.tenant_id == getTenantId()
                    && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin() && resource.data.tenant_id == getTenantId();
      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isSignedIn() && resource.data.tenant_id == getTenantId();
      allow create, update, delete: if isAdmin() && resource.data.tenant_id == getTenantId();
    }

    match /news_articles/{articleId} {
      allow read: if true; // Publicly readable for news section
      allow write: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if true; // Public contact form submission
      allow read, update, delete: if isAdmin();
    }
  }
}
```

---

## 3. Deployment Instructions

To deploy these rules to Firebase:

1. Install Firebase CLI if not already installed: `npm install -g firebase-tools`
2. Authenticate with Firebase: `firebase login`
3. Deploy rules using: `firebase deploy --only firestore:rules`
